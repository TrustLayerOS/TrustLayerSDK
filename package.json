{
  "name": "@trustlayer/sdk",
  "version": "0.1.0",
  "description": "TrustLayer SDK — trust infrastructure for the AI-native internet",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "clean": "rimraf dist"
  },
  "keywords": [
    "trust",
    "fraud",
    "deepfake",
    "bot-detection",
    "security",
    "ai",
    "interview-integrity",
    "risk-scoring"
  ],
  "author": "TrustLayer",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "29.5.12",
    "@types/node": "20.11.24",
    "jest": "29.7.0",
    "rimraf": "5.0.5",
    "ts-jest": "29.1.2",
    "tsup": "8.0.2",
    "typescript": "5.4.2"
  }
}
