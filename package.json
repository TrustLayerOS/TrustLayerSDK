{
  "name": "@trustlayer/sdk",
  "version": "0.1.0",
  "description": "TrustLayer SDK — prove the other side is a real human",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "browser": "dist/trustlayer.iife.global.js",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react.mjs",
      "require": "./dist/react.js",
      "types": "./dist/react.d.ts"
    },
    "./middleware": {
      "import": "./dist/middleware.mjs",
      "require": "./dist/middleware.js",
      "types": "./dist/middleware.d.ts"
    },
    "./mobile": {
      "import": "./dist/mobile.mjs",
      "require": "./dist/mobile.js",
      "types": "./dist/mobile.d.ts"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "clean": "rimraf dist"
  },
  "keywords": [
    "trust",
    "fraud",
    "deepfake",
    "bot-detection",
    "security",
    "ai",
    "interview-integrity",
    "risk-scoring"
  ],
  "author": "TrustLayer",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "29.5.12",
    "@types/node": "20.11.24",
    "@types/react": "18.2.79",
    "jest": "29.7.0",
    "react": "18.2.0",
    "rimraf": "5.0.5",
    "ts-jest": "29.1.2",
    "tsup": "8.0.2",
    "typescript": "5.4.2"
  }
}
